# Машинозависимые настройки стенда. Нужны, только если порт по умолчанию занят:
#   cp .env.example .env   и правь значения в .env (docker compose читает его сам).
# Без .env стенд поднимается на портах по умолчанию, указанных ниже.

# Порты, публикуемые на хост.
APP_PORT=8000
NGINX_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
MIMIR_PORT=9009
# node-exporter работает в сети хоста; при смене порта поправь цели
# в prometheus/prometheus.yml и alloy/config.alloy.
NODE_EXPORTER_PORT=9100
ALLOY_PORT=12345
