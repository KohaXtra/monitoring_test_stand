    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Доля 5xx по маршруту; `or … * 0` — ноль для маршрутов без ошибок.\nКандидат в алерт (симптом, с отсечкой по трафику, чтобы не срабатывать на единичных запросах):\n```\n(\n  (sum by (handler) (rate(http_requests_total{status=~\"5..\"}[5m]))\n    or sum by (handler) (rate(http_requests_total[5m])) * 0)\n  / sum by (handler) (rate(http_requests_total[5m]))\n) > 0.05\nand sum by (handler) (rate(http_requests_total[5m])) > 0.1\n```",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "showValues": false,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "(\nsum by (handler) (rate(http_requests_total{status=~\"5..\", handler=~\"$route\"}[$__rate_interval]))\n    or\nsum by (handler) (rate(http_requests_total{handler=~\"$route\"}[$__rate_interval])) * 0\n  )\n  /\nsum by (handler) (rate(http_requests_total{handler=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "mixed",
        "uid": "-- Mixed --"
      },
      "description": "p95 из гистограммы приложения (Mimir) и из логов nginx (Loki) рядом. Гистограмма интерполирует внутри бакета, логи дают значение по каждому запросу — дороже, но точнее.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (handler, le) (rate(http_request_duration_seconds_bucket{handler=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "app {{handler}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": " quantile_over_time(0.95,\n    {service=\"nginx\"}\n      | json\n      | upstream_response_time != \"-\"\n      | label_format route=`{{ regexReplaceAll \"^/hello/[^/]+$\" (regexReplaceAll \"^/items/[0-9]+$\" .uri\n  \"/items/{item_id}\") \"/hello/{name}\" }}`\n      | route=~\"^($route)$\"\n      | unwrap upstream_response_time [1m]\n  ) by (route)",
          "legendFormat": "nginx {{route}}",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "title": "Duration p95",
      "type": "stat"
    }
  ],
